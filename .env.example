# ============================================================
# STILL Wellness — variables de entorno
# Copia este archivo como `.env` y llena tus credenciales reales.
# Si dejas una sección vacía, ese módulo corre en MODO SIMULACIÓN.
# ============================================================

PORT=3000
BASE_URL=http://localhost:3000
STORE_EMAIL=hola@stillwellness.mx

# --- Mercado Pago (el dinero llega a ESTA cuenta) ---
# Obtén tus credenciales en: https://www.mercadopago.com.mx/developers/panel
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# --- Proveedor / dropshipping (orden de compra automática) ---
# CJ v2 se autentica con el EMAIL de tu cuenta CJ + tu API Key (My CJ > Authorization > API).
SUPPLIER_NAME=CJ Dropshipping
SUPPLIER_EMAIL=
SUPPLIER_API_KEY=
SUPPLIER_API_BASE=https://developers.cjdropshipping.com/api2.0/v1
SUPPLIER_FROM_COUNTRY=CN

# --- Paquetería (guía + tracking) ---
SHIPPING_PROVIDER=skydropx        # skydropx | envia
SHIPPING_API_KEY=
SHIPPING_API_BASE=https://api.skydropx.com/v1

# Dirección de origen (bodega proveedor o tu CEDIS)
ORIGIN_NAME=STILL Fulfillment
ORIGIN_STREET=Av. Central 100
ORIGIN_CITY=Ciudad de México
ORIGIN_STATE=CDMX
ORIGIN_ZIP=06000
ORIGIN_PHONE=5555555555
